# Leave these unset to run the app in demo mode with local sample data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public pages (required by both stores). Host the files in docs/ somewhere.
EXPO_PUBLIC_SITE_URL=https://snippets.app
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_SUPPORT_URL=

# Invite links. Use an https URL once universal/app links are set up (see docs/STORE_RELEASE.md).
# EXPO_PUBLIC_INVITE_BASE_URL=https://snippets.app/invite/

# Crash reporting (Sentry). Leave unset to disable. Never active in dev builds.
# EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (source maps), set as *sensitive* EAS env vars, not here:
# SENTRY_AUTH_TOKEN= SENTRY_ORG= SENTRY_PROJECT=
